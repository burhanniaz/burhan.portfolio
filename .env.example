# Copy to .env.local for local development with `vercel dev`.
# On Vercel, set these under Project → Settings → Environment Variables.

# --- Required: the admin password you type at /admin ---
ADMIN_PASSWORD=choose-a-long-random-password

# --- Required: signs the admin session cookie ---
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Added automatically when you attach a Postgres database in Vercel ---
# (Vercel Postgres / Neon both set this.) Only needed by hand for local dev.
POSTGRES_URL=

# --- Added automatically when you create a Blob store in Vercel ---
BLOB_READ_WRITE_TOKEN=
